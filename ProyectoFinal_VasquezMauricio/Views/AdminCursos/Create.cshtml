@model CursoFormViewModel
@{ ViewData["Title"] = "Nuevo curso"; }
<div class="card p-4 mx-auto" style="max-width:760px">
    <h1 class="page-title h3">Nuevo curso</h1>
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <partial name="_Form" model="Model" />
        <div class="mt-4">
            <button class="btn btn-primary">Guardar</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
