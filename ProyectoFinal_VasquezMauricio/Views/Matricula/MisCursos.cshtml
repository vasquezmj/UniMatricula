@model List<Matricula>
@{ ViewData["Title"] = "Mis cursos"; }

<h1 class="page-title h3 mb-3">Mis cursos matriculados</h1>

@if (!Model.Any())
{
    <div class="alert alert-info">Aún no tienes cursos matriculados. <a asp-action="Index" class="fw-semibold">Ir a matrícula</a></div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle bg-white border">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Curso</th>
                    <th>Docente</th>
                    <th>Créditos</th>
                    <th class="text-end">Acción</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td class="fw-semibold">@m.Curso!.Codigo</td>
                    <td>@m.Curso.Nombre</td>
                    <td>@(m.Curso.Docente?.Nombre ?? "Por asignar")</td>
                    <td>@m.Curso.Creditos</td>
                    <td class="text-end">
                        <form asp-action="Retirar" asp-route-id="@m.Id" method="post" onsubmit="return confirm('¿Retirar este curso?');">
                            <button class="btn btn-outline-danger btn-sm">Retirar</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <p class="fw-bold">Total: @Model.Count cursos · @Model.Sum(m => m.Curso!.Creditos) créditos</p>
    <a class="btn btn-primary" asp-action="Index">Matricular más cursos</a>
}
