@model List<CarreraItemViewModel>
@{ ViewData["Title"] = "Carreras"; int pagina = ViewBag.Pagina; int total = ViewBag.TotalPaginas; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-title mb-0">Elige tu carrera</h1>
    <form method="get" class="d-flex gap-2">
        <input name="q" value="@ViewBag.Q" class="form-control" placeholder="Buscar carrera…" />
        <button class="btn btn-primary">Buscar</button>
    </form>
</div>
@if (!Model.Any())
{
    <div class="alert alert-info">No se encontraron carreras.</div>
}
<div class="row g-3">
    @foreach (var c in Model)
    {
        <div class="col-md-4">
            <div class="card p-3 h-100 carrera-card @(c.Seleccionada ? "selected" : "")">
                <h2 class="h5 text-primary">@c.Nombre</h2>
                <p class="text-muted small flex-grow-1">@c.Descripcion</p>
                <p class="small mb-2">@c.CantidadCursos cursos</p>
                @if (c.Seleccionada)
                {
                    <span class="btn btn-success btn-sm disabled">✓ Seleccionada</span>
                }
                else
                {
                    <form asp-action="Seleccionar" asp-route-id="@c.Id" method="post">
                        <button class="btn btn-outline-primary btn-sm">Seleccionar</button>
                    </form>
                }
            </div>
        </div>
    }
</div>
@if (total > 1)
{
    <nav class="mt-4"><ul class="pagination justify-content-center">
        @for (int i = 1; i <= total; i++)
        {
            <li class="page-item @(i == pagina ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-q="@ViewBag.Q" asp-route-pagina="@i">@i</a></li>
        }
    </ul></nav>
}
