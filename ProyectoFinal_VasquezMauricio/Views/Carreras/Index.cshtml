@model List<CarreraItemViewModel>
@{ ViewData["Title"] = "Carreras"; int pagina = ViewBag.Pagina; int total = ViewBag.TotalPaginas; }

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h1 class="page-title mb-0">Elige tu carrera</h1>
    <form method="get" class="d-flex gap-2">
        <input name="q" value="@ViewBag.Q" class="form-control" placeholder="Buscar carrera…" style="min-width:240px" />
        <button class="btn btn-primary">Buscar</button>
    </form>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No se encontraron carreras.</div>
}

<div class="row g-3">
    @foreach (var c in Model)
    {
        <div class="col-md-4">
            <div class="card p-3 h-100 carrera-card d-flex flex-column @(c.Seleccionada ? "selected" : "")">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <div class="carrera-avatar" aria-hidden="true">@c.Inicial</div>
                    <div>
                        <h2 class="h5 mb-0 page-title">@c.Nombre</h2>
                        <span class="text-muted small">@c.CantidadCursos cursos</span>
                    </div>
                </div>
                <p class="text-muted small flex-grow-1 mb-3">@c.Descripcion</p>
                <div>
                    @if (c.Seleccionada)
                    {
                        <span class="btn btn-accent btn-sm disabled w-100">✓ Seleccionada</span>
                    }
                    else
                    {
                        <form asp-action="Seleccionar" asp-route-id="@c.Id" method="post">
                            <button class="btn btn-outline-primary btn-sm w-100">Seleccionar</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
</div>

@if (total > 1)
{
    <nav class="mt-4" aria-label="Paginación de carreras">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= total; i++)
            {
                <li class="page-item @(i == pagina ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-q="@ViewBag.Q" asp-route-pagina="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}
