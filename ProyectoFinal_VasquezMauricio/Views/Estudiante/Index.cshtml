@model EstudiantePanelViewModel
@{ ViewData["Title"] = "Inicio"; }

<div class="mb-3">
    <h1 class="page-title mb-2">Hola, @Model.Nombre</h1>
    @if (Model.Carrera != null)
    {
        <span class="carrera-pill">@Model.Carrera</span>
    }
    else
    {
        <div class="alert alert-warning mt-2">Aún no tienes carrera seleccionada. <a asp-controller="Carreras" asp-action="Index" class="fw-semibold">Selecciona una carrera</a>.</div>
    }
</div>

<div class="matricula-banner mb-4">
    Matrícula abierta hasta el 20 de octubre. ¡Aún tienes cursos por inscribir!
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card p-3 h-100">
            <div class="stat">@Model.Creditos</div>
            <div class="text-muted">Créditos matriculados</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 h-100">
            <div class="stat">@Model.Cursos</div>
            <div class="text-muted">Cursos inscritos</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 h-100">
            <div class="stat">@Model.Periodo</div>
            <div class="text-muted">Periodo</div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card p-4 action-card-navy h-100">
            <h2 class="h5 fw-bold">Matricular cursos</h2>
            <p class="text-white-50 mb-3">Ver los cursos de mi carrera y matricularlos</p>
            <div class="mt-auto">
                <a class="btn btn-accent" asp-controller="Matricula" asp-action="Index">Ir a matrícula</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card p-4 h-100">
            <h2 class="h5 fw-bold page-title">Mis cursos</h2>
            <p class="text-muted mb-3">Consultar los cursos que ya inscribí</p>
            <div class="mt-auto">
                <a class="btn btn-primary" asp-controller="Matricula" asp-action="MisCursos">Ver mis cursos</a>
            </div>
        </div>
    </div>
</div>
