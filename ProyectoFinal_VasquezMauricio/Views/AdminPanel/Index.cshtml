@model DashboardAdminViewModel
@{ ViewData["Title"] = "Panel de administración"; }
<h1 class="page-title">Panel de administración</h1>
<div class="row g-3 mb-4">
    <div class="col"><div class="card p-3 text-center"><div class="stat">@Model.Estudiantes</div><div class="text-muted">Estudiantes</div></div></div>
    <div class="col"><div class="card p-3 text-center"><div class="stat">@Model.Carreras</div><div class="text-muted">Carreras</div></div></div>
    <div class="col"><div class="card p-3 text-center"><div class="stat">@Model.Cursos</div><div class="text-muted">Cursos</div></div></div>
    <div class="col"><div class="card p-3 text-center"><div class="stat">@Model.Docentes</div><div class="text-muted">Docentes</div></div></div>
    <div class="col"><div class="card p-3 text-center"><div class="stat">@Model.Matriculas</div><div class="text-muted">Matrículas</div></div></div>
</div>
<div class="row g-3">
    <div class="col-md-4"><div class="card p-4 text-bg-primary h-100"><h2 class="h5">Carreras</h2><p>Crear, editar y eliminar</p><div><a class="btn btn-accent" asp-controller="AdminCarreras" asp-action="Index">Gestionar</a></div></div></div>
    <div class="col-md-4"><div class="card p-4 text-bg-primary h-100"><h2 class="h5">Cursos</h2><p>Crear, editar y asociar a carreras</p><div><a class="btn btn-accent" asp-controller="AdminCursos" asp-action="Index">Gestionar</a></div></div></div>
    <div class="col-md-4"><div class="card p-4 text-bg-primary h-100"><h2 class="h5">Profesores</h2><p>Registrar y asignar a cursos</p><div><a class="btn btn-accent" asp-controller="AdminDocentes" asp-action="Index">Gestionar</a></div></div></div>
</div>
