@model DashboardAdminViewModel
@{ ViewData["Title"] = "Panel de administración"; }

<h1 class="page-title h3 mb-3">Panel de administración</h1>

<div class="row g-3 mb-4">
    <div class="col-6 col-md"><div class="card p-3 text-center h-100"><div class="stat">@Model.Estudiantes</div><div class="text-muted small">Estudiantes</div></div></div>
    <div class="col-6 col-md"><div class="card p-3 text-center h-100"><div class="stat">@Model.Carreras</div><div class="text-muted small">Carreras</div></div></div>
    <div class="col-6 col-md"><div class="card p-3 text-center h-100"><div class="stat">@Model.Cursos</div><div class="text-muted small">Cursos</div></div></div>
    <div class="col-6 col-md"><div class="card p-3 text-center h-100"><div class="stat">@Model.Docentes</div><div class="text-muted small">Docentes</div></div></div>
    <div class="col-12 col-md"><div class="card p-3 text-center h-100"><div class="stat">@Model.Matriculas</div><div class="text-muted small">Matrículas</div></div></div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card p-4 action-card-navy h-100">
            <h2 class="h5 fw-bold">Carreras</h2>
            <p class="text-white-50 mb-3">Crear, editar y eliminar</p>
            <div class="mt-auto"><a class="btn btn-accent" asp-controller="AdminCarreras" asp-action="Index">Gestionar</a></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-4 action-card-navy h-100">
            <h2 class="h5 fw-bold">Cursos</h2>
            <p class="text-white-50 mb-3">Crear, editar y asociar a carreras</p>
            <div class="mt-auto"><a class="btn btn-accent" asp-controller="AdminCursos" asp-action="Index">Gestionar</a></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-4 action-card-navy h-100">
            <h2 class="h5 fw-bold">Profesores</h2>
            <p class="text-white-50 mb-3">Registrar y asignar a cursos</p>
            <div class="mt-auto"><a class="btn btn-accent" href="/Admin/Profesores">Gestionar</a></div>
        </div>
    </div>
</div>

<div class="card p-4">
    <h2 class="h5 fw-bold page-title mb-3">Últimas matrículas</h2>
    @if (!Model.UltimasMatriculas.Any())
    {
        <p class="text-muted mb-0">Aún no se registran matrículas en el sistema.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Estudiante</th>
                        <th>Curso</th>
                        <th>Fecha</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var m in Model.UltimasMatriculas)
                {
                    <tr>
                        <td class="fw-semibold">@m.Estudiante</td>
                        <td>@m.Curso</td>
                        <td>@m.Fecha.ToString("dd/MM/yyyy")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
