@model RegisterViewModel
@{ ViewData["Title"] = "Registro"; }

<div class="card p-4 p-lg-5 mx-auto shadow-sm" style="max-width:740px">
    <h1 class="page-title h3 mb-1">Crea tu cuenta</h1>
    <p class="text-muted mb-4">Todos los campos son obligatorios</p>

    <form asp-action="Register" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Nombre" class="form-label fw-semibold">Nombre</label>
                <input asp-for="Nombre" class="form-control" placeholder="Ana" />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Apellidos" class="form-label fw-semibold">Apellidos</label>
                <input asp-for="Apellidos" class="form-control" placeholder="Mora Rojas" />
                <span asp-validation-for="Apellidos" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Cedula" class="form-label fw-semibold">Cédula</label>
                <input asp-for="Cedula" class="form-control" placeholder="1-2345-6789" />
                <span asp-validation-for="Cedula" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Email" class="form-label fw-semibold">Correo electrónico</label>
                <input asp-for="Email" class="form-control" placeholder="ana.mora@correo.com" autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Password" class="form-label fw-semibold">Contraseña</label>
                <input asp-for="Password" class="form-control" placeholder="Mín. 8 caracteres, 1 mayúscula, 1 número" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirmar contraseña</label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="Repite la contraseña" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="CarreraId" class="form-label fw-semibold">Carrera</label>
                <select asp-for="CarreraId" asp-items="(IEnumerable<SelectListItem>)ViewBag.Carreras" class="form-select">
                    <option value="">Selecciona una carrera</option>
                </select>
                <span asp-validation-for="CarreraId" class="text-danger small"></span>
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <button type="submit" class="btn btn-accent w-100 py-2">Crear cuenta</button>
            </div>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
