@model List<Carrera>
@{ ViewData["Title"] = "Carreras"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-title h3 mb-0">Carreras</h1>
    <button type="button" id="btnNuevaCarrera" class="btn btn-accent">+ Nueva carrera</button>
</div>

<div id="alertaAjax" class="alert d-none" role="alert"></div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="table-responsive">
            <table class="table align-middle bg-white border mb-2" id="tablaCarreras">
                <thead>
                    <tr>
                        <th>Carrera</th>
                        <th>Descripción</th>
                        <th>Cursos</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody id="tbodyCarreras">
                @foreach (var c in Model)
                {
                    <tr data-id="@c.Id" data-nombre="@c.Nombre" data-descripcion="@c.Descripcion">
                        <td class="fw-semibold">@c.Nombre</td>
                        <td>@c.Descripcion</td>
                        <td>@c.CarreraCursos.Count</td>
                        <td class="text-end text-nowrap">
                            <button type="button" class="btn btn-outline-primary btn-sm btn-editar me-1"
                                    data-id="@c.Id" data-nombre="@c.Nombre" data-descripcion="@c.Descripcion">Editar</button>
                            <button type="button" class="btn btn-outline-danger btn-sm btn-eliminar"
                                    data-id="@c.Id" data-nombre="@c.Nombre">Eliminar</button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <p class="ajax-hint mb-0">La tabla se actualiza por AJAX sin recargar</p>
    </div>

    <div class="col-lg-4">
        <div class="card p-4 resumen-card">
            <h2 id="formTitulo" class="h5 fw-bold page-title mb-3">Nueva carrera</h2>
            <form id="formCarrera" asp-action="GuardarAjax" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="carreraId" name="id" value="0" />
                <div class="mb-3">
                    <label for="carreraNombre" class="form-label fw-semibold">Nombre</label>
                    <input id="carreraNombre" name="nombre" class="form-control" placeholder="Ej. Turismo" required maxlength="100" />
                </div>
                <div class="mb-3">
                    <label for="carreraDescripcion" class="form-label fw-semibold">Descripción</label>
                    <textarea id="carreraDescripcion" name="descripcion" class="form-control" rows="3" placeholder="Breve descripción" required maxlength="300"></textarea>
                </div>
                <div class="d-flex gap-2 mb-3">
                    <button type="submit" class="btn btn-primary flex-grow-1">Guardar</button>
                    <button type="button" id="btnCancelar" class="btn btn-outline-secondary">Cancelar</button>
                </div>
                <p class="text-muted small mb-0">Una carrera con estudiantes no puede eliminarse</p>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    (function () {
        const form = document.getElementById('formCarrera');
        const titulo = document.getElementById('formTitulo');
        const inputId = document.getElementById('carreraId');
        const inputNombre = document.getElementById('carreraNombre');
        const inputDesc = document.getElementById('carreraDescripcion');
        const alerta = document.getElementById('alertaAjax');
        const token = form.querySelector('input[name="__RequestVerificationToken"]').value;

        function mostrarAlerta(msg, ok) {
            alerta.className = `alert ${ok ? 'alert-success' : 'alert-danger'} py-2`;
            alerta.textContent = msg;
        }

        function limpiarFormulario() {
            inputId.value = '0';
            inputNombre.value = '';
            inputDesc.value = '';
            titulo.textContent = 'Nueva carrera';
        }

        async function recargarTabla() {
            const res = await fetch('/Admin/Carreras/ListaJson');
            if (!res.ok) return;
            const datos = await res.json();
            const tbody = document.getElementById('tbodyCarreras');
            tbody.innerHTML = '';
            datos.forEach(c => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="fw-semibold">${c.nombre}</td>
                    <td>${c.descripcion}</td>
                    <td>${c.cursos}</td>
                    <td class="text-end text-nowrap">
                        <button type="button" class="btn btn-outline-primary btn-sm btn-editar me-1"
                                data-id="${c.id}" data-nombre="${c.nombre}" data-descripcion="${c.descripcion}">Editar</button>
                        <button type="button" class="btn btn-outline-danger btn-sm btn-eliminar"
                                data-id="${c.id}" data-nombre="${c.nombre}">Eliminar</button>
                    </td>`;
                tbody.appendChild(tr);
            });
            enlazarBotones();
        }

        function enlazarBotones() {
            document.querySelectorAll('.btn-editar').forEach(btn => {
                btn.addEventListener('click', function () {
                    inputId.value = this.dataset.id;
                    inputNombre.value = this.dataset.nombre;
                    inputDesc.value = this.dataset.descripcion;
                    titulo.textContent = 'Editar carrera';
                    inputNombre.focus();
                });
            });

            document.querySelectorAll('.btn-eliminar').forEach(btn => {
                btn.addEventListener('click', async function () {
                    if (!confirm(`¿Eliminar la carrera "${this.dataset.nombre}"?`)) return;
                    const fd = new FormData();
                    fd.append('__RequestVerificationToken', token);
                    const res = await fetch(`/Admin/Carreras/EliminarAjax/${this.dataset.id}`, {
                        method: 'POST',
                        body: fd
                    });
                    const json = await res.json();
                    mostrarAlerta(json.mensaje, res.ok);
                    if (res.ok) await recargarTabla();
                });
            });
        }

        form.addEventListener('submit', async function (e) {
            e.preventDefault();
            const fd = new FormData(form);
            const res = await fetch('/Admin/Carreras/GuardarAjax', {
                method: 'POST',
                body: fd
            });
            const json = await res.json();
            mostrarAlerta(json.mensaje, res.ok);
            if (res.ok) {
                limpiarFormulario();
                await recargarTabla();
            }
        });

        document.getElementById('btnCancelar').addEventListener('click', limpiarFormulario);
        document.getElementById('btnNuevaCarrera').addEventListener('click', () => {
            limpiarFormulario();
            inputNombre.focus();
        });

        enlazarBotones();
    })();
</script>
}
