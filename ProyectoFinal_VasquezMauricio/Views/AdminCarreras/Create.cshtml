@model Carrera
@{ ViewData["Title"] = "Nueva carrera"; }
<div class="card p-4 mx-auto" style="max-width:640px">
    <h1 class="page-title h3">Nueva carrera</h1>
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <partial name="_Form" model="Model" />
        <button class="btn btn-primary">Guardar</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
